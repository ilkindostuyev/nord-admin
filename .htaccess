Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
# Old source folders may remain from earlier manual uploads.
RewriteRule ^(?:dist|artwork-originals|components|data|i18n|styles|hosting|cpanel|admin-ui)(?:/|$) - [F,L]
# One public origin. Local development hosts are unaffected.
RewriteCond %{HTTP_HOST} ^www\.nordatech\.az$ [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(?:www\.)?nordatech\.az$ [NC]
RewriteRule ^ https://nordatech.az%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{THE_REQUEST} "\s/+index(?:\.html)?(?:[?\s])" [NC]
RewriteRule ^index(?:\.html)?$ / [R=301,L]

# HTML is the canonical form used by internal links, hreflang and sitemap.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ /$1.html [R=301,L,NE]
RewriteRule ^(products|articles)/([a-z0-9-]+(?:\.(?:en|ru))?)$ /$1/$2.html [R=301,L,NE]

# Activate server rendering only in the cPanel package, where PHP is present.
RewriteCond %{DOCUMENT_ROOT}/norda-render.php -f
RewriteRule ^sitemap\.xml$ norda-render.php [END]
RewriteCond %{DOCUMENT_ROOT}/norda-render.php -f
RewriteRule ^$ norda-render.php [END,QSA]
RewriteCond %{DOCUMENT_ROOT}/norda-render.php -f
RewriteRule ^(?:(?:products|guides|articles)/)?[a-z0-9.-]+\.html$ norda-render.php [END,QSA]
</IfModule>

<FilesMatch "^\.">
Require all denied
</FilesMatch>
<FilesMatch "\.(?:mjs|md|sqlite|log|ya?ml|ini)$|^(?:package|package-lock)\.json$">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
